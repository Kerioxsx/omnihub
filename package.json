{
  "name": "omnihub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OmniHub: Windows PC companion — storage analysis, apps, screenshots, notes, vault, phone companion and screen sharing",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --config vite.mobile.config.ts",
    "build": "npm run typecheck && vite build && vite build --config vite.mobile.config.ts",
    "build:desktop": "vite build",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "typecheck": "tsc --noEmit -p .",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "dompurify": "^3.4.16",
    "lucide-react": "^1.50.0",
    "marked": "^18.0.14",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  }
}
